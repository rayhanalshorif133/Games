{
  "project": {
    "name": "Merge Numbers",
    "version": "1.0.0.0",
    "description": "2248 Connect puzzle game with 3D squircle tiles, dynamic drag chains, gravity drop, and juicy combo synthesis",
    "author": "GameCooker",
    "uniqueId": "merge-numbers-c3-build",
    "firstLayout": "Game",
    "viewportWidth": 1080,
    "viewportHeight": 1920,
    "viewportScale": "letterbox-scale",
    "orientation": "portrait",
    "useLoaderLayout": false,
    "fullscreenMode": "letterbox-scale",
    "pixelRounding": false,
    "sampling": "linear",
    "framerateMode": "vsync",
    "downscalingQuality": "high",
    "flowDirection": "ltr"
  },
  "layouts": [
    {
      "name": "Game",
      "width": 1080,
      "height": 1920,
      "unboundedScrolling": false,
      "layers": [
        { "name": "Background", "parallaxX": 1, "parallaxY": 1, "opacity": 1, "transparent": false, "visible": true },
        { "name": "GridSlots", "parallaxX": 1, "parallaxY": 1, "opacity": 1, "transparent": true, "visible": true },
        { "name": "Tiles", "parallaxX": 1, "parallaxY": 1, "opacity": 1, "transparent": true, "visible": true },
        { "name": "Connections", "parallaxX": 1, "parallaxY": 1, "opacity": 1, "transparent": true, "visible": true },
        { "name": "Particles", "parallaxX": 1, "parallaxY": 1, "opacity": 1, "transparent": true, "visible": true },
        { "name": "BottomBanner", "parallaxX": 1, "parallaxY": 1, "opacity": 1, "transparent": true, "visible": true },
        { "name": "Tutorial", "parallaxX": 1, "parallaxY": 1, "opacity": 1, "transparent": true, "visible": true },
        { "name": "UI", "parallaxX": 1, "parallaxY": 1, "opacity": 1, "transparent": true, "visible": true },
        { "name": "Popups", "parallaxX": 1, "parallaxY": 1, "opacity": 1, "transparent": true, "visible": true },
        { "name": "Modal", "parallaxX": 1, "parallaxY": 1, "opacity": 1, "transparent": true, "visible": true }
      ]
    }
  ],
  "objectTypes": [
    { "name": "Background", "pluginId": "Sprite", "asset": "images/background.png" },
    { "name": "TileSlot", "pluginId": "Sprite", "asset": "images/tile_slot.png" },
    { "name": "Tile_2", "pluginId": "Sprite", "asset": "images/tile_2.png" },
